import {
  noa::gen {Gen, apply, gen, gen-bind, gen-map},
  noa::suite {gen-kit},
  _gen {gen-non-empty-token},
  field {Field, field},
}

define _gen-field() -> gen(field) {
  with gen-bind {
    bind key = gen-non-empty-token();
    gen-map(gen-non-empty-token(), (value) => {
      Field{key, value}
    })
  }
}

constant gen-field: gen(field) {
  Gen(
    <r>(k: &gen-kit) =>> {
      apply<r, field>(_gen-field(), k)
    },
  )
}
