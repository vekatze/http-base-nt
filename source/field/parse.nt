import {
  core::function {compose},
  core::list {append},
  zonk::parse {chunk, not-followed-by, optional, parsed, take-while, zonk, zonk-kit},
  this::_parse {is-colon, skip-space, until-newline},
  this::field {Field, field},
}

define _field-value-parser@(k: &zonk-kit, acc: list(string)) -> parsed(string) {
  try new-fragment = until-newline@(k);
  try _ = chunk@("\r")@(k);
  try none-or-newline = optional@(chunk@("\n"))@(k);
  match none-or-newline {
  | Left(_) =>
    _field-value-parser@(k, append(acc, List::[new-fragment, *"\r"]))
  | Right(_) =>
    Right(core::string::join(append(acc, List::[new-fragment])))
  }
}

constant field-parser: zonk(field) {
  @(k) => {
    try _ = not-followed-by@("newline", chunk@("\r\n"))@(k);
    try key = take-while@(compose(not, is-colon))@(k);
    try _ = chunk@(":")@(k);
    try _ = skip-space@(k);
    try value = _field-value-parser@(k, Nil);
    Right(Field{key, value})
  }
}
