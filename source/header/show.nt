import {
  core::list {for-each, length},
  core::string {intercalate, join},
  this::field.show {show-field},
  this::header {header},
}

define show-header(fields: header) -> string {
  let len on fields = length(fields);
  if eq-int(len, 0) {
    *""
  } else {
    let ts = for-each(fields, show-field);
    let k = intercalate(ts, *"\r\n");
    join(List::[k, *"\r\n"])
  }
}

constant as-show: show(header) {
  Show{
    render := {
      (h) => {
        show-header(*h)
      }
    },
  }
}
