import {
  core::string {append},
  noa::gen {gen, gen-map},
  noa::gen.generic {Alphanumeric, derive},
}

define gen-token() -> gen(string) {
  derive::()[rune-category := Alphanumeric]
}

define gen-non-empty-token() -> gen(string) {
  gen-map(gen-token(), (t) => {
    pin t = t;
    append(t, "a")
  })
}
