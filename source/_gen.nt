import {
  core.list.eq {member},
  noa.gen {gen},
  noa.gen.custom.string {string-gen},
}

data config {
| Config(
    blacklist: list(rune),
    min-length: int,
  )
}

inline adjusted-string-gen(!c: config) -> gen(string) {
  let Config{min-length, blacklist} = c;
  string-gen(noa.gen.custom.string.Config{
    min-length,
    max-length := none,
    rune-generator := none,
    rune-acceptor := {
      (r) => {
        pin bk = blacklist;
        pin r = r;
        pin k = core.rune.eq.as-eq;
        not(member(k, bk, r))
      }
    },
  })
}
