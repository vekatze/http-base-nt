import {
  core::list {length},
  core::string {split},
  noa::suite {make-default-noa-kit},
  noa::suite.spec {check, property},
  zonk::parse {make-zonk-kit},
  this::request {request},
  this::request.gen {gen-request},
  this::request.parse.v1-1 {request-parser},
  this::request.show.v1-1 {show-request},
  this::response {response},
  this::response.gen {gen-response},
  this::response.parse.v1-1 {response-parser},
  this::response.show.v1-1 {show-response},
}

define main() -> unit {
  pin k = make-default-noa-kit@();
  check(k, List::[
    property::(
      "∀ (r: request). show(parse(show(r))) == show(r)",
      gen-request,
      (r: &request) => {
        pin req-string-1 = show-request(*r);
        pin k = make-zonk-kit@(*req-string-1);
        match request-parser@(k) {
        | Right(req) =>
          pin req-string-2 = show-request(req);
          eq-string(req-string-1, req-string-2)
        | Left(_) =>
          False
        }
      },
    ),
    property::(
      "∀ (r: request). `show(r)` contains at least one empty line",
      gen-request,
      (r: &request) => {
        pin req-string = show-request(*r);
        pin segments = split(req-string, "\r\n\r\n");
        ge-int(length(segments), 2)
      },
    ),
    property::(
      "∀ (r: response). show(parse(show(r))) == show(r)",
      gen-response,
      (r: &response) => {
        pin req-string-1 = show-response(*r);
        pin k = make-zonk-kit@(*req-string-1);
        match response-parser@(k) {
        | Right(req) =>
          pin req-string-2 = show-response(req);
          eq-string(req-string-1, req-string-2)
        | Left(_) =>
          False
        }
      },
    ),
    property::(
      "∀ (r: response). `show(r)` contains at least one empty line",
      gen-response,
      (r: &response) => {
        pin req-string = show-response(*r);
        pin segments = split(req-string, "\r\n\r\n");
        ge-int(length(segments), 2)
      },
    ),
  ])
}

define zen() -> unit {
  main()
}
