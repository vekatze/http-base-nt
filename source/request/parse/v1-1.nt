import {
  this._parse {http-line-break, read-all, skip-space, symbol},
  this.header.parse {header-parser},
  this.request {Request, request},
  this.request-method.parse {request-method-parser},
  zonk.parse {zonk},
}

constant request-parser<c>: zonk(c, request) {
  (k) => {
    try method = request-method-parser(k);
    try _ = skip-space(k);
    try path = symbol(k);
    try _ = skip-space(k);
    try protocol-version = symbol(k);
    let _ = protocol-version;
    try _ = http-line-break(k);
    try fields = header-parser()(k);
    try _ = http-line-break(k);
    try body = read-all(k);
    Right(
      Request{
        method,
        path,
        fields,
        body,
      },
    )
  }
}
