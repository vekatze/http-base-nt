import {
  core::string {join},
  header.show {show-header},
  request {Request, request},
  request-method.show {show-request-method},
}

define show-request(r: request) -> string {
  let Request{method, path, fields, body} = r;
  join(List::[
    show-request-method(method),
    *" ",
    path,
    *" ",
    *"HTTP/1.1",
    *"\r\n",
    show-header(fields),
    *"\r\n",
    body,
  ])
}

constant as-show: show(request) {
  Show{
    render := {
      (req) => {
        show-request(*req)
      }
    },
  }
}
