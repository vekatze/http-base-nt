import {
  noa::gen {Gen, apply, gen, gen-bind, gen-map},
  noa::gen.generic {derive},
  noa::suite {gen-kit},
  this::_gen {gen-non-empty-token},
  this::header.gen {gen-header},
  this::request {Request, request},
  this::request-method {request-method},
}

define gen-request-method() -> gen(request-method) {
  derive::()
}

define _gen-request() -> gen(request) {
  with gen-bind {
    bind method = gen-request-method();
    bind path = gen-non-empty-token();
    bind fields = gen-header;
    gen-map(gen-non-empty-token(), (body) => {
      Request{method, path, fields, body}
    })
  }
}

constant gen-request: gen(request) {
  Gen(
    @<r>(k: &gen-kit) => {
      apply@<r, request>(_gen-request(), k)
    },
  )
}
