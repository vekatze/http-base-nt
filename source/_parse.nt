import {
  core.function {compose},
  zonk.parse {chunk, drop-while, take-while, zonk},
}

define is-space(r: rune) -> bool {
  if eq-rune(r, ` `) {
    True
  } else-if and(le-rune(`\u{9}`, r), le-rune(r, `\u{D}`)) {
    True
  } else {
    False
  }
}

define is-colon(r: rune) -> bool {
  eq-rune(r, `:`)
}

constant skip-space<c>: zonk(c, unit) {
  drop-while(is-space)
}

constant symbol<c>: zonk(c, string) {
  take-while(compose(not, is-space))
}

constant until-newline<c>: zonk(c, string) {
  take-while((r) => {
    ne-rune(r, `\r`)
  })
}

constant http-line-break<c>: zonk(c, unit) {
  chunk("\r\n")
}

constant read-all<c>: zonk(c, string) {
  take-while((_) => {
    True
  })
}

define is-status-code-number(r: rune) -> bool {
  and(le-rune(`0`, r), le-rune(r, `9`))
}
