import {
  core::function {compose},
  zonk::parse {chunk, drop-while, take-while, zonk},
}

define is-space(r: rune) -> bool {
  if eq-rune(r, ` `) {
    True
  } else-if and::(le-rune(`\u{9}`, r), le-rune(r, `\u{D}`)) {
    True
  } else {
    False
  }
}

define is-colon(r: rune) -> bool {
  eq-rune(r, `:`)
}

constant skip-space: zonk(unit) {
  drop-while(is-space)
}

constant symbol: zonk(string) {
  take-while(compose(not, is-space))
}

constant until-newline: zonk(string) {
  take-while((r) => {
    ne-rune(r, `\r`)
  })
}

constant http-line-break: zonk(unit) {
  chunk("\r\n")
}

constant read-all: zonk(string) {
  take-while((_) => {
    True
  })
}

define is-status-code-number(r: rune) -> bool {
  and::(le-rune(`0`, r), le-rune(r, `9`))
}
