import {
  noa::gen {Gen, apply, gen, gen-bind, gen-map},
  noa::gen.int {gen-int},
  noa::suite {gen-kit},
  this::_gen {gen-non-empty-token},
  this::header.gen {gen-header},
  this::response {Response, response},
}

define _gen-response() -> gen(response) {
  with gen-bind {
    bind status-code = gen-int(100, 999, 200);
    bind fields = gen-header;
    gen-map(gen-non-empty-token(), (body) => {
      Response{status-code, fields, body}
    })
  }
}

constant gen-response: gen(response) {
  Gen(
    <r>(k: &gen-kit) =>> {
      apply<r, response>(_gen-response(), k)
    },
  )
}
