import {
  core.int.parse {parse-int},
  this._parse {http-line-break, is-status-code-number, read-all, skip-space, symbol, until-newline},
  this.header.parse {header-parser},
  this.response {Response, response},
  zonk.parse {report-unexpected-input, take-while, zonk},
}

constant _status-code<c>: zonk(c, int) {
  (k) => {
    try status-code-string = take-while(is-status-code-number)(k);
    let status-code-or-none on status-code-string = parse-int(status-code-string);
    let _ = status-code-string;
    match status-code-or-none {
    | Right(v) =>
      Right(v)
    | Left(_) =>
      report-unexpected-input("status code")
    }
  }
}

constant response-parser<c>: zonk(c, response) {
  (k) => {
    try protocol-version = symbol(k);
    let _ = protocol-version;
    try _ = skip-space(k);
    try status-code = _status-code(k);
    try _ = skip-space(k);
    try reason-phrase = until-newline(k);
    let _ = reason-phrase;
    try _ = http-line-break(k);
    try fields = header-parser()(k);
    try _ = http-line-break(k);
    try body = read-all(k);
    Right(
      Response{
        status-code,
        fields,
        body,
      },
    )
  }
}
