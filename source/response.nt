import {
  core::int.show {show-int},
  core::string {byte-length},
  field {Field},
  header {header},
}

data response {
| Response(
    status-code: int,
    fields: header,
    body: string,
  )
}

define string-response(status-code: int, body: string) -> response {
  let len on body = byte-length(body);
  Response{
    status-code,
    fields := List::[Field(*"content-length", show-int(len))],
    body,
  }
}
